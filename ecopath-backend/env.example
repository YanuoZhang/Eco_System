# Environment Configuration
NODE_ENV=development

# Database Configuration
DB_USER=ecopath_user
DB_HOST=localhost
DB_NAME=ecopath
DB_PASSWORD=
DB_PORT=5432
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Server Configuration
PORT=5001

# CORS Configuration
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://leafforward.space,https://www.leafforward.space
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML Service Configuration
# Development: http://127.0.0.1:8001/predict
# Production: https://ml.leafforward.space/predict
ML_SERVICE_URL=http://127.0.0.1:8001/predict
