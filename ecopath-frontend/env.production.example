# Production environment variables for site authentication
# Copy this to .env.production and adjust values for your deployment

# Set to "true" only if your production site uses HTTPS
NEXT_PUBLIC_HTTPS=false

# Set your production domain (without https://)
# Leave empty for localhost or if you don't need domain restriction
NEXT_PUBLIC_DOMAIN=

# Site password (optional, defaults to "Ecopath@123")
SITE_PASSWORD=Ecopath@123

# Auth secret for token generation (optional, defaults to "dev-secret")
SITE_AUTH_SECRET=your-secure-secret-here
