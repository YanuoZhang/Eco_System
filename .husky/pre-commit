#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

branch_name=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch_name" = "main" ]; then
  echo "[Husky] Direct commits to 'main' are blocked. Please create a feature branch and open a PR."
  exit 1
fi

# Run unit tests for frontend and backend before committing
printf "[Husky] Running workspace unit tests...\n"
npm --workspace ecopath-frontend run test || exit 1
npm --workspace ecopath-backend run test || exit 1

printf "[Husky] Pre-commit checks passed.\n"
