#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

branch_name=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch_name" = "main" ]; then
  echo "[Husky] Direct pushes to 'main' are blocked. Please open a PR instead."
  exit 1
fi

echo "[Husky] Root pre-push checks passed (no source in root)."

# Run frontend E2E tests before pushing
echo "[Husky] Running frontend E2E tests (Playwright)..."
npm --workspace ecopath-frontend run test:e2e || exit 1
echo "[Husky] E2E tests passed."
