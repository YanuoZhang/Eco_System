-- =====================================================================
-- 99_load_all.psql  (run with: psql ... -f data/99_load_all.psql)
-- Purpose: Orchestrate schema + all data loads
-- =====================================================================
\set ON_ERROR_STOP on
\pset pager off
\timing on

ROLLBACK;

\echo '== EcoPath DB | START =='

\echo '-> 01_schema.sql'
\i ./01_schema.sql

\echo '-> 02_load_emissions.sql'
\i ./02_load_emissions.sql

\echo '-> 03_load_population.sql'
\i ./03_load_population.sql

\echo '-> 04_load_generation.sql'
\i ./04_load_generation.sql

\echo '-> 05_load_state_initiatives.sql'
\i ./05_load_state_initiatives.sql

\echo '== EcoPath DB | DONE =='
