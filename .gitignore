# Global ignores for all workspaces
.DS_Store

# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/build/
**/.next/
**/out/

# Test artifacts
**/coverage/
**/test-results/
**/playwright-report/

# Env files (keep examples tracked)
**/.env
**/.env.local
**/.env.*
!**/.env.example

# Logs / debug
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Tooling
**/*.tsbuildinfo
**/.vercel/

